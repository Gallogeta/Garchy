* {
    bg: rgba(18, 18, 18, 0.96);
    bg-alt: rgba(28, 28, 28, 0.85);
    bg-hover: rgba(255, 255, 255, 0.15);
    bg-selected: rgba(255, 255, 255, 0.30);
    border-col: rgba(50, 50, 50, 0.9);
    border-accent: #ffffff;
    accent: #ffffff;
    accent-alt: #cccccc;
    fg: #ffffff;
    fg-muted: #777777;
    fg-selected: #ffffff;
    urgent: #f7768e;
    radius: 0px;
}
