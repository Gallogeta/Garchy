#!/usr/bin/env python3
"""
Cephalon Gally — Instant Terminal Assistant (100% Offline)
3 Persona Modes (Child, Normal, Professional Sudo), Sudo Gate & Privacy Controls.
"""

import os
import sys
import json
import subprocess
import urllib.request

sys.path.insert(0, os.path.expanduser("~/.config/hypr/scripts"))
try:
    import gally_memory_manager
except Exception:
    gally_memory_manager = None

def main():
    if len(sys.argv) < 2:
        print("\033[1;36m🌌 CEPHALON GALLY — SYSTEM MATRIX READY (100% Offline)\033[0m")
        print("Usage: ai [options] <query>")
        print("Modes:")
        print("  ai --child <query>   ➔ 🧸 Child Mode (Extra safe, simple, and friendly)")
        print("  ai --sudo <query>    ➔ ⚡ Professional Sudo Mode (Deep Linux sysadmin architect)")
        print("  ai <query>           ➔ 🚀 Normal Mode (Balanced Cephalon companion)")
        print("\nExamples:")
        print("  ai 'how to install blender'")
        print("  ai 'open youtube'")
        print("  ai --sudo 'analyze btrfs subvolumes and memory fragmentation'")
        print("  ai --child 'what is a computer mouse?'")
        sys.exit(0)

    mode = "normal"
    args = sys.argv[1:]
    
    if args[0] in ["--child", "-c"]:
        mode = "child"
        args = args[1:]
    elif args[0] in ["--sudo", "-s"]:
        mode = "professional_sudo"
        args = args[1:]

    prompt = " ".join(args)

    if gally_memory_manager:
        cfg = gally_memory_manager.load_config()
        if mode == "normal":
            mode = cfg.get("mode", "normal")
            
        mem_res = gally_memory_manager.check_for_memory_directives(prompt)
        if mem_res:
            print(f"\033[1;33m◈ CEPHALON GALLY:\033[0m\n{mem_res}\n")
            sys.exit(0)
            
        # Check browser link
        p_lower = prompt.lower()
        if p_lower.startswith("open ") and ("http" in p_lower or ".com" in p_lower or "youtube" in p_lower or "google" in p_lower):
            url = prompt[5:].strip()
            gally_memory_manager.open_browser_link(url)
            print(f"\033[1;32m◈ Launching browser to '{url}' for Operator...\033[0m\n")
            sys.exit(0)
            
        full_prompt = gally_memory_manager.build_mode_system_prompt(
            prompt, mode=mode, internet_ok=cfg.get("internet_permitted", False), doc_ok=cfg.get("document_access_permitted", False)
        )
    else:
        full_prompt = prompt

    badge_color = "\033[1;35m" if mode == "child" else ("\033[1;31m" if mode == "professional_sudo" else "\033[1;33m")
    print(f"{badge_color}◈ CEPHALON GALLY [{mode.upper()}]:\033[0m Computing matrices for Operator...\n")

    url = "http://127.0.0.1:11434/api/generate"
    payload = json.dumps({
        "model": "gally-cephalon-ai",
        "prompt": full_prompt,
        "stream": True
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})

    try:
        with urllib.request.urlopen(req) as response:
            for line in response:
                if line:
                    data = json.loads(line.decode("utf-8"))
                    print(data.get("response", ""), end="", flush=True)
            print("\n")
    except Exception as e:
        print(f"\033[1;31mOperator, anomaly detected connecting to local matrix: {e}\033[0m")

if __name__ == "__main__":
    main()
