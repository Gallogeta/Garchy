#!/usr/bin/env python3
"""
Gally AI — Instant Terminal Assistant (100% Offline)
Powered by local Ollama & gally-linux-ai
"""

import sys
import json
import urllib.request

def main():
    if len(sys.argv) < 2:
        print("🌌 Gally AI Terminal Assistant (100% Offline)")
        print("Usage: ai <your question or problem in quotes>")
        print("Example: ai 'how to update packages' or ai 'fix sound'")
        sys.exit(0)

    prompt = " ".join(sys.argv[1:])
    print(f"\033[1;33m🤖 Gally AI (Offline):\033[0m Thinking...\n")

    url = "http://127.0.0.1:11434/api/generate"
    payload = json.dumps({
        "model": "gally-linux-ai",
        "prompt": prompt,
        "stream": True
    }).encode("utf-8")

    req = urllib.request.Request(url, data=payload, headers={"Content-Type": "application/json"})

    try:
        with urllib.request.urlopen(req) as response:
            for line in response:
                if line:
                    data = json.loads(line.decode("utf-8"))
                    print(data.get("response", ""), end="", flush=True)
            print("\n")
    except Exception as e:
        print(f"\033[1;31mError connecting to Ollama offline daemon: {e}\033[0m")
        print("Make sure ollama is running (`systemctl start ollama` or `ollama serve`).")

if __name__ == "__main__":
    main()
