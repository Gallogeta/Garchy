#!/usr/bin/env python3
"""
Cephalon Gally — Instant Terminal Assistant (100% Offline + Multi-Cloud Models)
3 Persona Modes (Child, Normal, Professional Sudo), In-Terminal Login & Memory.
"""

import os
import sys
import json
import subprocess

sys.path.insert(0, os.path.expanduser("~/.config/hypr/scripts"))
try:
    import gally_ai_router
except Exception:
    gally_ai_router = None

try:
    import gally_memory_manager
except Exception:
    gally_memory_manager = None

def main():
    if len(sys.argv) < 2:
        print("\033[1;36m🌌 CEPHALON GALLY — TERMINAL ASSISTANT\033[0m")
        print("Usage: ai [options] <query or directive>")
        print("\nTerminal Directives:")
        print("  ai login              ➔ 🔑 Show API keys and cloud login guide")
        print("  ai login gemini <key> ➔ 🔑 Register Gemini API key and switch model")
        print("  ai model <name>       ➔ 🔄 Switch model (local, gemini, claude, openai, deepseek, groq)")
        print("  ai models             ➔ 📋 List all available models")
        print("  ai status             ➔ 📊 Show current engine, mode & privacy status")
        print("\nModes:")
        print("  ai --child <query>    ➔ 🧸 Child Mode (Extra safe, simple, and friendly)")
        print("  ai --sudo <query>     ➔ ⚡ Professional Sudo Mode (Deep Linux sysadmin architect)")
        print("  ai <query>            ➔ 🚀 Normal Mode (Balanced Cephalon companion)")
        sys.exit(0)

    mode = "normal"
    args = sys.argv[1:]
    
    if args[0] in ["--child", "-c"]:
        mode = "child"
        args = args[1:]
    elif args[0] in ["--sudo", "-s"]:
        mode = "professional_sudo"
        args = args[1:]

    prompt = " ".join(args)

    if gally_ai_router:
        cfg = gally_ai_router.load_ai_config()
        if mode == "normal":
            mode = cfg.get("mode", "normal")
            
        # 1. In-Terminal Login / API / Model Directives
        handled, cli_msg, new_cfg = gally_ai_router.handle_terminal_command(prompt, cfg)
        if handled:
            print(f"\033[1;33m{cli_msg}\033[0m\n")
            sys.exit(0)
            
        # 2. Memory Directives
        if gally_memory_manager:
            mem_res = gally_memory_manager.check_for_memory_directives(prompt)
            if mem_res:
                print(f"\033[1;33m◈ CEPHALON GALLY:\033[0m\n{mem_res}\n")
                sys.exit(0)
                
            full_prompt = gally_memory_manager.build_mode_system_prompt(
                prompt, mode=mode, internet_ok=cfg.get("internet_permitted", False), doc_ok=cfg.get("document_access_permitted", False)
            )
        else:
            full_prompt = prompt

        active_mod = cfg.get("active_model", "gally-cephalon-ai")
        badge_color = "\033[1;35m" if mode == "child" else ("\033[1;31m" if mode == "professional_sudo" else "\033[1;33m")
        print(f"{badge_color}◈ CEPHALON GALLY [{active_mod.upper()} | {mode.upper()}]:\033[0m Streaming matrices for Operator...\n")

        def on_token(token):
            print(token, end="", flush=True)

        def on_complete(full_resp):
            print("\n")

        gally_ai_router.stream_query(full_prompt, cfg, on_token, on_complete)
    else:
        print("Error: AI router not found.")

if __name__ == "__main__":
    main()
