#!/usr/bin/env bash
if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
    exec /usr/bin/garchy-gui-installer "$@"
else
    # Fallback to TUI terminal wizard if no GUI display
    exec python3 /home/gallo/Garchy/scripts/garchy-installer.py "$@" 2>/dev/null || exec /usr/bin/garchy-gui-installer "$@"
fi
