#!/usr/bin/env python3
"""
Garchy OS - Simple & Modern Guided Installer
Step-by-Step wizard for installing Garchy Linux (Btrfs + Snapper + Hyprland + AI)
"""

import os
import sys
import subprocess
import time
import shutil

CYAN = "\033[96m"
BLUE = "\033[94m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
RESET = "\033[0m"

def clear_screen():
    os.system("clear")

def print_header(step_text=""):
    print(f"{CYAN}{BOLD}")
    print(" ╔══════════════════════════════════════════════════════════════╗")
    print(" ║                       🌌 GARCHY OS                           ║")
    print(" ║            Simple & Modern Guided System Installer           ║")
    print(" ╚══════════════════════════════════════════════════════════════╝")
    print(f"{RESET}")
    if step_text:
        print(f" {YELLOW}{BOLD}▶ {step_text}{RESET}\n")

def run(cmd, check=True):
    print(f"{BLUE}>> {cmd}{RESET}")
    return subprocess.run(cmd, shell=True, check=check)

def get_disks():
    res = subprocess.run(["lsblk", "-d", "-n", "-o", "NAME,SIZE,MODEL,TYPE"], stdout=subprocess.PIPE, text=True)
    disks = []
    for line in res.stdout.strip().splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1] == "disk" and not parts[0].startswith("loop") and not parts[0].startswith("airootfs"):
            name = f"/dev/{parts[0]}"
            size = parts[1]
            model = " ".join(parts[2:-1]) if len(parts) > 3 else "Disk"
            disks.append((name, size, model))
    return disks

def step_welcome():
    clear_screen()
    print_header("Welcome to Garchy OS")
    print(" Garchy OS is a minimalist, high-performance Arch Linux distribution")
    print(" featuring a tuned Hyprland desktop, built-in AI Copilot, and gaming/dev stack.\n")
    print(f" {GREEN}This installer will guide you through 4 easy steps:{RESET}")
    print("  1. Select target installation drive")
    print("  2. Set up your user account & password")
    print("  3. Review configuration summary")
    print("  4. Automatic partitioning, packages & rice deployment\n")
    input(f" Press {BOLD}[ Enter ]{RESET} to begin...")

def step_select_disk():
    clear_screen()
    print_header("Step 1 of 4: Select Target Hard Drive")
    disks = get_disks()
    if not disks:
        print(f"{RED}No suitable hard drives detected!{RESET}")
        sys.exit(1)
        
    print(f" {BOLD}Detected Hard Drives:{RESET}")
    for idx, (name, size, model) in enumerate(disks, 1):
        print(f"   [{CYAN}{idx}{RESET}] {BOLD}{name}{RESET}  —  Size: {YELLOW}{size}{RESET} ({model})")
        
    print(f"\n {RED}{BOLD}WARNING:{RESET} The selected disk will be formatted for Garchy OS.")
    while True:
        choice = input(f"\n Select drive number (1-{len(disks)}): ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(disks):
            selected = disks[int(choice) - 1][0]
            confirm = input(f" Confirm installation to {BOLD}{selected}{RESET}? (yes/no): ").strip().lower()
            if confirm in ("yes", "y"):
                return selected

def step_user_account():
    clear_screen()
    print_header("Step 2 of 4: Create User Account")
    
    while True:
        username = input(f" Enter username [{CYAN}gallo{RESET}]: ").strip() or "gallo"
        if username.isalnum():
            break
        print(f"{RED}Username must be alphanumeric.{RESET}")
        
    while True:
        password = input(" Enter password for your account: ").strip()
        if not password:
            print(f"{RED}Password cannot be empty.{RESET}")
            continue
        confirm = input(" Confirm password: ").strip()
        if password == confirm:
            break
        print(f"{RED}Passwords do not match! Try again.{RESET}")
        
    hostname = input(f" Enter PC hostname [{CYAN}garchy-pc{RESET}]: ").strip() or "garchy-pc"
    return username, password, hostname

def step_confirm_summary(disk, username, hostname):
    clear_screen()
    print_header("Step 3 of 4: Installation Summary")
    print(f" {BOLD}Target Disk:{RESET}      {CYAN}{disk}{RESET}")
    print(f" {BOLD}Filesystem:{RESET}       {GREEN}Btrfs (with Snapper snapshot protection){RESET}")
    print(f" {BOLD}Desktop Rice:{RESET}     {CYAN}Hyprland Dual-144Hz + Glassmorphism{RESET}")
    print(f" {BOLD}System Tools:{RESET}     {CYAN}Garchy AI Copilot + Silent Auto-Updater{RESET}")
    print(f" {BOLD}User Account:{RESET}     {CYAN}{username}{RESET} (sudo enabled)")
    print(f" {BOLD}PC Hostname:{RESET}      {CYAN}{hostname}{RESET}\n")
    
    print(f" {YELLOW}Ready to proceed with installation.{RESET}")
    choice = input(f" Type {BOLD}'install'{RESET} to start: ").strip().lower()
    if choice != "install":
        print("Installation cancelled by user.")
        sys.exit(0)

def step_install(disk, username, password, hostname):
    clear_screen()
    print_header("Step 4 of 4: Installing Garchy OS...")
    
    print(f"\n{BOLD}[1/7] Partitioning {disk} (GPT / UEFI)...{RESET}")
    run(f"wipefs -af {disk}")
    run(f"parted -s {disk} mklabel gpt")
    run(f"parted -s {disk} mkpart ESP fat32 1MiB 513MiB")
    run(f"parted -s {disk} set 1 esp on")
    run(f"parted -s {disk} mkpart primary btrfs 513MiB 100%")
    
    # Handle NVMe vs SATA partition naming
    p1 = f"{disk}p1" if "nvme" in disk or "mmcblk" in disk else f"{disk}1"
    p2 = f"{disk}p2" if "nvme" in disk or "mmcblk" in disk else f"{disk}2"
    
    print(f"\n{BOLD}[2/7] Formatting Filesystems (FAT32 & Btrfs Subvolumes)...{RESET}")
    run(f"mkfs.fat -F 32 {p1}")
    run(f"mkfs.btrfs -f {p2}")
    
    # Mount and create subvolumes
    run(f"mount {p2} /mnt")
    run("btrfs subvolume create /mnt/@")
    run("btrfs subvolume create /mnt/@home")
    run("btrfs subvolume create /mnt/@snapshots")
    run("umount /mnt")
    
    # Mount subvolumes
    run(f"mount -o noatime,compress=zstd,subvol=@ {p2} /mnt")
    run("mkdir -p /mnt/home /mnt/.snapshots /mnt/boot")
    run(f"mount -o noatime,compress=zstd,subvol=@home {p2} /mnt/home")
    run(f"mount -o noatime,compress=zstd,subvol=@snapshots {p2} /mnt/.snapshots")
    run(f"mount {p1} /mnt/boot")
    
    print(f"\n{BOLD}[3/7] Copying Garchy OS Base System & Packages...{RESET}")
    # Pacstrap base packages
    run("pacstrap -K /mnt base base-devel linux linux-headers linux-firmware sudo git zsh starship hyprland waybar rofi dunst kitty thunar sddm xfce4 xfce4-goodies pipewire pipewire-pulse wireplumber networkmanager ttf-jetbrains-mono-nerd noto-fonts-emoji efibootmgr snapper btrfs-progs python jq fastfetch")
    
    print(f"\n{BOLD}[4/7] Configuring System & User Account...{RESET}")
    run("genfstab -U /mnt >> /mnt/etc/fstab")
    
    # Setup hostname & locale
    with open("/mnt/etc/hostname", "w") as f:
        f.write(f"{hostname}\n")
        
    with open("/mnt/etc/locale.gen", "w") as f:
        f.write("en_US.UTF-8 UTF-8\n")
    run("arch-chroot /mnt locale-gen")
    
    with open("/mnt/etc/locale.conf", "w") as f:
        f.write("LANG=en_US.UTF-8\n")
        
    # Setup User & Sudo
    run(f"arch-chroot /mnt useradd -m -G wheel -s /bin/zsh {username}")
    run(f"echo '{username}:{password}' | arch-chroot /mnt chpasswd")
    run(f"echo 'root:{password}' | arch-chroot /mnt chpasswd")
    run("echo '%wheel ALL=(ALL:ALL) ALL' > /mnt/etc/sudoers.d/10-wheel")
    
    print(f"\n{BOLD}[5/7] Deploying Garchy Rice, Wallpapers & AI Engine...{RESET}")
    user_home = f"/mnt/home/{username}"
    run(f"mkdir -p {user_home}/.config {user_home}/Pictures/Wallpapers {user_home}/.local/bin")
    
    if os.path.exists("/etc/skel/.config"):
        run(f"cp -r /etc/skel/.config/* {user_home}/.config/ 2>/dev/null || true")
    if os.path.exists("/etc/skel/Pictures/Wallpapers"):
        run(f"cp -r /etc/skel/Pictures/Wallpapers/* {user_home}/Pictures/Wallpapers/ 2>/dev/null || true")
        
    run("cp /usr/bin/garchy-ai /mnt/usr/bin/garchy-ai 2>/dev/null || true")
    run("cp /usr/bin/garchy-update /mnt/usr/bin/garchy-update 2>/dev/null || true")
    run("ln -sf /usr/bin/garchy-ai /mnt/usr/bin/ai")
    run("chmod +x /mnt/usr/bin/garchy-ai /mnt/usr/bin/garchy-update 2>/dev/null || true")
    
    # Deploy SDDM Garchy Theme
    if os.path.exists("/usr/share/sddm/themes/garchy"):
        run("mkdir -p /mnt/usr/share/sddm/themes/")
        run("cp -r /usr/share/sddm/themes/garchy /mnt/usr/share/sddm/themes/ 2>/dev/null || true")
    if os.path.exists("/etc/sddm.conf.d"):
        run("mkdir -p /mnt/etc/sddm.conf.d")
        run("cp -r /etc/sddm.conf.d/* /mnt/etc/sddm.conf.d/ 2>/dev/null || true")
        
    run(f"chown -R 1000:1000 {user_home}")
    
    print(f"\n{BOLD}[6/7] Installing UEFI Bootloader (systemd-boot)...{RESET}")
    run("arch-chroot /mnt bootctl install")
    
    # Write systemd-boot loader configuration
    with open("/mnt/boot/loader/loader.conf", "w") as f:
        f.write("default garchy.conf\ntimeout 3\nconsole-mode max\neditor no\n")
        
    p2_uuid = subprocess.check_output(f"blkid -s UUID -o value {p2}", shell=True).decode().strip()
    with open("/mnt/boot/loader/entries/garchy.conf", "w") as f:
        f.write(f"title   Garchy OS (Linux)\nlinux   /vmlinuz-linux\ninitrd  /initramfs-linux.img\noptions root=UUID={p2_uuid} rootflags=subvol=@ rw quiet splash\n")
        
    print(f"\n{BOLD}[7/7] Enabling Core Services (SDDM & NetworkManager)...{RESET}")
    run("arch-chroot /mnt systemctl enable sddm NetworkManager")
    
    print(f"\n{GREEN}{BOLD}══════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{GREEN}{BOLD}   ✨ GARCHY OS INSTALLATION COMPLETED SUCCESSFULLY! ✨        ║{RESET}")
    print(f"{GREEN}{BOLD}══════════════════════════════════════════════════════════════╝{RESET}\n")
    print(f" You can now reboot and select Garchy OS in your boot menu.")
    input(f"\n Press {BOLD}[ Enter ]{RESET} to exit installer...")

def main():
    if os.geteuid() != 0:
        print(f"{RED}Please run garchy-installer as root (sudo garchy-installer).{RESET}")
        sys.exit(1)
        
    step_welcome()
    disk = step_select_disk()
    username, password, hostname = step_user_account()
    step_confirm_summary(disk, username, hostname)
    step_install(disk, username, password, hostname)

if __name__ == "__main__":
    main()
