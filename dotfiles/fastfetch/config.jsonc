{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/garchy.txt",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ➔ ",
    "color": {
      "keys": "cyan",
      "title": "yellow"
    }
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "wm",
      "key": "Desktop"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "gpu",
      "key": "GPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "key": "Storage (/)",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "custom",
      "key": "Cephalon AI",
      "format": "Online ⚡ (Super+Shift+Space / 'ai')"
    },
    {
      "type": "custom",
      "key": "Audio Spectrum",
      "format": " ▂▃▄▅▆▇█  (30Hz Sub-Bass ➔ 14kHz Treble)"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "block"
    }
  ]
}
