{
    "layer": "top",
    "position": "top",
    "exclusive": true,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "height": 36,
    "spacing": 6,

    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "custom/btn-minimize",
        "custom/btn-maximize",
        "custom/btn-close",
        "mpris",
        "clock"
    ],
    "modules-right": [
        "custom/quick-ssh",
        "cpu",
        "custom/gpu",
        "memory",
        "temperature",
        "pulseaudio",
        "custom/ai-hub",
        "custom/theme",
        "custom/help",
        "tray",
        "custom/power"
    ],

    "custom/launcher": {
        "format": "󰣇",
        "on-click": "/home/gallo/.config/hypr/scripts/launchpad.sh",
        "on-click-right": "/home/gallo/.config/hypr/scripts/wallpaper-select.sh",
        "tooltip-format": "Gally Launchpad (Left Click)\nWallpaper Menu (Right Click)"
    },

    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": false,
        "disable-scroll": false,
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "1", "2": "1",
            "3": "2", "4": "2",
            "5": "3", "6": "3",
            "7": "4", "8": "4",
            "9": "5", "10": "5",
            "11": "6", "12": "6",
            "13": "7", "14": "7",
            "15": "8", "16": "8",
            "17": "9", "18": "9",
            "19": "10", "20": "10"
        }
    },

    "wlr/taskbar": {
        "format": "{icon} {name}",
        "icon-size": 16,
        "icon-theme": "Papirus-Dark",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "fullscreen",
        "ignore-list": [
            "wlogout",
            "rofi"
        ]
    },

    "custom/btn-minimize": {
        "format": "",
        "tooltip-format": "Minimize Active Window (Left Click)\nRestore Last Window (Right Click)",
        "on-click": "/home/gallo/.config/hypr/scripts/minimize-window.sh minimize",
        "on-click-right": "/home/gallo/.config/hypr/scripts/minimize-window.sh restore-last"
    },

    "custom/btn-maximize": {
        "format": "󰍹",
        "tooltip-format": "Maximize / Toggle Fullscreen",
        "on-click": "/home/gallo/.config/hypr/scripts/minimize-window.sh maximize-toggle"
    },

    "custom/btn-close": {
        "format": "󰅖",
        "tooltip-format": "Close Active Window (Left Click)\nForce Kill Program (Right Click)",
        "on-click": "/home/gallo/.config/hypr/scripts/minimize-window.sh close-window",
        "on-click-right": "/home/gallo/.config/hypr/scripts/force-kill.sh"
    },

    "mpris": {
        "format": " {title} - {artist}",
        "format-paused": " {title} - {artist}",
        "max-length": 26,
        "tooltip-format": "{player}: {title} - {artist}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next"
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%a, %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#7aa2f7'><b>{}</b></span>",
                "days": "<span color='#c0caf5'><b>{}</b></span>",
                "weeks": "<span color='#73daca'><b>W{}</b></span>",
                "weekdays": "<span color='#ff9e64'><b>{}</b></span>",
                "today": "<span color='#f7768e'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "custom/quick-ssh": {
        "format": "󰢹 SSH",
        "tooltip-format": "SSH Servers & Quick Connect",
        "on-click": "/home/gallo/.config/hypr/scripts/quick-ssh.sh"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip-format": "Ryzen 9 5900X (24 Threads)\nUsage: {usage}%\nLoad: {load}",
        "interval": 2
    },

    "custom/gpu": {
        "exec": "/home/gallo/.config/hypr/scripts/gpu_usage.sh",
        "return-type": "json",
        "format": "{}",
        "interval": 2,
        "tooltip": true
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "RAM Used: {used:0.1f}G / {total:0.1f}G ({percentage}%)",
        "interval": 2
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip-format": "CPU Temperature: {temperatureC}°C",
        "interval": 2
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 4,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%"
    },

    "custom/ai-hub": {
        "format": "🤖 Gally AI",
        "tooltip-format": "Gally AI Copilot & Troubleshooter (Super + Shift + Space)",
        "on-click": "/home/gallo/.config/hypr/scripts/gally-ai-hud.sh"
    },

    "custom/theme": {
        "format": "󰏘",
        "tooltip-format": "Desktop Theme Switcher\n(Tokyo Night, Catppuccin, Nord, Cyberpunk, etc.)",
        "on-click": "/home/gallo/.config/hypr/scripts/theme-switcher.sh"
    },

    "custom/help": {
        "format": "❓",
        "tooltip-format": "Quick Guide & Keyboard Shortcuts (F1)",
        "on-click": "/home/gallo/.config/hypr/scripts/help-hud.sh"
    },

    "tray": {
        "icon-size": 15,
        "spacing": 8
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power Menu",
        "on-click": "wlogout -b 2 -c 20 -r 20"
    }
}
