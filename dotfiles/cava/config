## ==============================================================================
## 🌌 Garchy OS CAVA Configuration (PipeWire + 144Hz + Dynamic Gradients)
## ==============================================================================

[general]
mode = normal
framerate = 144
autosens = 1
overshoot = 20
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
max_height = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 12000
sleep_timer = 3

[input]
method = pipewire
source = auto

[output]
channels = stereo
mono_option = average

[color]
gradient = 1
gradient_count = 6

gradient_color_1 = '#131c31'
gradient_color_2 = '#1e3a8a'
gradient_color_3 = '#3b82f6'
gradient_color_4 = '#38bdf8'
gradient_color_5 = '#7dd3fc'
gradient_color_6 = '#fbbf24'

[smoothing]
integral = 70
monstercat = 1
waves = 0
gravity = 100
noise_reduction = 0.77
