## ==============================================================================
## 🌌 Garchy OS CAVA Configuration (Compact Frequency Spectrum: Bass ➔ Treble)
## ==============================================================================

[general]
mode = normal
framerate = 144
autosens = 1
overshoot = 10
sensitivity = 110
bars = 20
bar_width = 2
bar_spacing = 1
max_height = 6
lower_cutoff_freq = 30
higher_cutoff_freq = 14000
sleep_timer = 2

[input]
method = pipewire
source = auto

[output]
channels = mono
mono_option = average

[color]
gradient = 1
gradient_count = 6

gradient_color_1 = '#131c31'
gradient_color_2 = '#1e3a8a'
gradient_color_3 = '#3b82f6'
gradient_color_4 = '#38bdf8'
gradient_color_5 = '#7dd3fc'
gradient_color_6 = '#fbbf24'

[smoothing]
integral = 70
monstercat = 1
waves = 0
gravity = 100
noise_reduction = 0.77
