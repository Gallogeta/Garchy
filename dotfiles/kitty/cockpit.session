# ==============================================================================
# 🌌 Garchy OS Unified Terminal Session (Shell + BTOP + CAVA)
# ==============================================================================

layout splits

# Launch Left Panel: Interactive Shell
launch --title "🌌 Garchy Core" zsh

# Launch Top Right Panel: BTOP Hardware Telemetry
launch --location=vsplit --title "⚡ BTOP Telemetry" btop

# Launch Bottom Right Panel: CAVA Audio Visualizer
launch --location=hsplit --title "🎵 CAVA Audio Waves" cava

# Focus
focus
