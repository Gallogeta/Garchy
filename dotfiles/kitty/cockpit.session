# ==============================================================================
# 🌌 Garchy OS Unified Terminal Session (Shell + BTOP + CAVA)
# ==============================================================================

layout splits

# Panel 1: Main Interactive Shell (Left)
launch --title "🌌 Garchy Core" zsh

# Panel 2: BTOP Hardware Telemetry (Top Right)
launch --location=vsplit --title "⚡ BTOP Telemetry" btop

# Panel 3: CAVA 144Hz Real-Time Audio Visualizer (Bottom Right)
launch --location=hsplit --title "🎵 CAVA Audio Waves" cava

# Ensure focus starts in the main interactive shell on the left
focus_matching --title "🌌 Garchy Core"
