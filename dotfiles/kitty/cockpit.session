# ==============================================================================
# 🌌 Garchy OS Terminal Session (Top: CAVA Visualizer | Bottom: Interactive Shell)
# ==============================================================================

layout splits

# Top Panel: CAVA 144Hz Real-Time Audio Visualizer
launch --title "🎵 CAVA Audio Waves" cava

# Bottom Panel: Main Interactive Shell
launch --location=hsplit --title "🌌 Garchy Core" zsh

# Focus the interactive shell so you can type immediately
focus
