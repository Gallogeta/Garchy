/**
 * =============================================================================
 * 🌌 Garchy OS — Fullscreen Launchpad Dashboard (Dynamic Themed)
 * =============================================================================
 */

@import "active-theme.rasi"

* {
    background-color: transparent;
    text-color: @fg-color;
    margin: 0px;
    padding: 0px;
}

window {
    transparency: "real";
    fullscreen: true;
    background-color: @bg-color;
    padding: 60px 120px;
    cursor: "default";
}

mainbox {
    spacing: 24px;
    children: [ inputbar, listview ];
}

inputbar {
    enabled: true;
    spacing: 12px;
    margin: 0px 240px;
    padding: 12px 24px;
    border: 2px;
    border-color: @accent-color;
    border-radius: 20px;
    background-color: @bg-card;
    text-color: @fg-color;
    children: [ prompt, entry ];
}

prompt {
    font: "JetBrainsMono Nerd Font Bold 12";
    text-color: @accent-color;
    vertical-align: 0.5;
}

entry {
    placeholder: "Type to filter applications...";
    placeholder-color: @fg-color;
    text-color: @fg-color;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    enabled: true;
    columns: 6;
    lines: 4;
    cycle: false;
    dynamic: true;
    scrollbar: true;
    scrollbar-width: 14px;
    layout: vertical;
    flow: horizontal;
    fixed-height: true;
    fixed-columns: true;
    spacing: 18px;
    margin: 10px 0px 0px 0px;
    background-color: transparent;
    cursor: "default";
}

scrollbar {
    enabled: true;
    width: 14px;
    handle-width: 14px;
    handle-color: @accent-color;
    border-radius: 8px;
    background-color: @bg-card;
    border: 1px;
    border-color: @accent-color;
    margin: 0px 0px 0px 14px;
    cursor: pointer;
}

element {
    enabled: true;
    orientation: vertical;
    spacing: 10px;
    padding: 18px 10px;
    border-radius: 16px;
    background-color: @bg-card;
    border: 1px;
    border-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: @bg-card;
    text-color: @fg-color;
}

element alternate.normal {
    background-color: @bg-card;
    text-color: @fg-color;
}

element selected.normal {
    background-color: @accent-color;
    border: 1.5px;
    border-color: @accent-color;
    text-color: @bg-color;
}

element normal.active {
    background-color: @bg-card;
    text-color: @fg-color;
}

element alternate.active {
    background-color: @bg-card;
    text-color: @fg-color;
}

element selected.active {
    background-color: @accent-color;
    border: 1.5px;
    border-color: @accent-color;
    text-color: @bg-color;
}

element-icon {
    size: 56px;
    cursor: inherit;
    horizontal-align: 0.5;
}

element-text {
    font: "JetBrainsMono Nerd Font Medium 11";
    cursor: inherit;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
}
