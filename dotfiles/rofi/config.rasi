/**
 * =============================================================================
 * 🌌 Garchy OS — Master Rofi Configuration
 * =============================================================================
 */

configuration {
    modi: "drun,run,window";
    font: "JetBrainsMono Nerd Font 12";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "normal";
    cycle: false;
    scroll-method: 0; /* 0 = Discrete page mode (prevents auto-scrolling; user must explicitly scroll) */

    /* Seamless Mouse Hover & Instant Single-Click Launch */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    me-accept-custom: "Control+MousePrimary";

    /* Fully Functional Mouse Wheel Scrolling */
    ml-row-up: "ScrollUp";
    ml-row-down: "ScrollDown";
    ml-row-left: "ScrollLeft";
    ml-row-right: "ScrollRight";

    click-to-exit: true;

    /* Display Labels */
    display-drun: "🔍 Search Apps:";
    display-run: "  Run:";
    display-window: "󰖯  Windows:";
}

@theme "~/.config/rofi/launchpad.rasi"
