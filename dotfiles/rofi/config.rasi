/**
 * Gally OS - Modern App Launcher & Command Runner
 */

@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
    window-format: "{w}  ·  {c}  ·  {t}";
    font: "JetBrainsMono Nerd Font 11";

    location: 0;
    fixed-num-lines: true;
    sidebar-mode: true;
    matching: "fuzzy";
    sort: true;
    sorting-method: "normal";
    click-to-exit: true;

    hover-select: true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";

    display-drun: "󰀻  Apps";
    display-run: "  Commands";
    display-window: "󰖯  Windows";

    kb-page-next: "Page_Down";
    kb-page-prev: "Page_Up";
    kb-paste: "Control+v,Shift+Insert";
    kb-primary-paste: "Control+Shift+v,Shift+Insert";
}

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 720px;
    height: 500px;
    background-color: @bg;
    border: 2px solid;
    border-color: @border-accent;
    border-radius: @radius;
    padding: 16px;
    cursor: "default";
}

mainbox {
    orientation: vertical;
    background-color: transparent;
    spacing: 12px;
    children: [ mode-switcher, inputbar, listview, message ];
}

mode-switcher {
    spacing: 8px;
    background-color: transparent;
}

button {
    padding: 7px 14px;
    background-color: @bg-alt;
    text-color: @fg-muted;
    border-radius: 10px;
    border: 1px solid @border-col;
    cursor: pointer;
    font: "JetBrainsMono Nerd Font Bold 11";
}

button selected {
    background-color: @accent;
    text-color: @fg-active;
    border: 1px solid @accent;
}

button:hover {
    background-color: @accent-alt;
    text-color: @fg-active;
}

inputbar {
    padding: 10px 14px;
    background-color: @bg-alt;
    border-radius: 10px;
    border: 1px solid @border-accent;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
    vertical-align: 0.5;
}

entry {
    placeholder: "Search applications or commands...";
    placeholder-color: @fg-muted;
    text-color: @fg;
    cursor: text;
    vertical-align: 0.5;
}

listview {
    columns: 1;
    lines: 7;
    cycle: true;
    dynamic: true;
    scrollbar: true;
    layout: vertical;
    spacing: 6px;
    background-color: transparent;
}

scrollbar {
    width: 5px;
    border: 0;
    handle-width: 5px;
    handle-color: @accent;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.08);
    margin: 0 0 0 8px;
}

element {
    padding: 9px 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
    spacing: 10px;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal,
element:hover {
    background-color: @accent;
    text-color: @fg-active;
    border-radius: 8px;
}

element-icon {
    size: 22px;
    cursor: inherit;
    vertical-align: 0.5;
}

element-text {
    font: "JetBrainsMono Nerd Font Medium 11";
    cursor: inherit;
    vertical-align: 0.5;
    text-color: inherit;
}

message {
    padding: 8px;
    border-radius: 8px;
    background-color: @bg-alt;
    border: 1px solid @border-col;
}

textbox {
    text-color: @fg;
}
