/* ===================================================================
 * Antigravity Riced Rofi Configuration
 * Fully Responsive, Dynamic Themed, Glassmorphic Multi-Tool Launcher
 * =================================================================== */

@import "active-theme.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    drun-display-format: "{name}";
    window-format: "{w}  ·  {c}  ·  {t}";
    font: "JetBrainsMono Nerd Font 12";

    location: 0;
    fixed-num-lines: true;
    sidebar-mode: true;
    scroll-method: 0;
    matching: "fuzzy";
    sort: true;
    sorting-method: "normal";
    click-to-exit: true;

    display-drun: "󰀻  Apps";
    display-run: "  Commands";
    display-window: "󰖯  Windows";

    kb-page-next: "Page_Down";
    kb-page-prev: "Page_Up";
    kb-paste: "Control+v,Shift+Insert";
    kb-primary-paste: "Control+Shift+v,Shift+Insert";
}

* {
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 780px;
    height: 540px;
    background-color: @bg;
    border: 2px;
    border-color: @border-accent;
    border-radius: @radius;
    padding: 20px;
}

mainbox {
    orientation: vertical;
    background-color: transparent;
    spacing: 16px;
    children: [mode-switcher, inputbar, listview, message];
}

/* --------------------------------------------------
 * MODE SWITCHER BAR (Apps / Commands / Windows Tabs)
 * -------------------------------------------------- */
mode-switcher {
    spacing: 8px;
    background-color: transparent;
}

button {
    padding: 8px 18px;
    background-color: @bg-alt;
    border: 1px;
    border-color: @border-col;
    border-radius: @radius;
    text-color: @fg-muted;
    font: "JetBrainsMono Nerd Font 11";
    cursor: pointer;
}

button selected {
    background-color: @accent;
    border-color: @accent;
    text-color: #131622;
    font: "JetBrainsMono Nerd Font Bold 11";
}

/* --------------------------------------------------
 * INPUT BAR & PROMPT
 * -------------------------------------------------- */
inputbar {
    background-color: @bg-alt;
    border: 1px;
    border-color: @border-col;
    border-radius: @radius;
    padding: 10px 16px;
    spacing: 12px;
    children: [prompt, entry];
}

prompt {
    enabled: true;
    background-color: transparent;
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 14";
    vertical-align: 0.5;
}

entry {
    background-color: transparent;
    text-color: @fg-selected;
    font: "JetBrainsMono Nerd Font 12";
    placeholder: "Search applications, windows, or math (=)...";
    placeholder-color: @fg-muted;
    vertical-align: 0.5;
}

/* --------------------------------------------------
 * 2-COLUMN LISTVIEW
 * -------------------------------------------------- */
listview {
    background-color: transparent;
    border: 0;
    spacing: 6px;
    padding: 4px 0;
    lines: 6;
    columns: 2;
    fixed-height: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    border: 1px;
    border-color: transparent;
    border-radius: @radius;
    padding: 8px 12px;
    spacing: 12px;
    cursor: pointer;
}

element-icon {
    size: 32px;
    background-color: transparent;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font 12";
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    background-color: @bg-hover;
    text-color: @accent;
}

element normal.urgent,
element alternate.urgent {
    background-color: rgba(247, 118, 142, 0.18);
    text-color: @urgent;
}

element selected.normal,
element selected.active {
    background-color: @bg-selected;
    border-color: @border-accent;
    text-color: @fg-selected;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #131622;
}

/* --------------------------------------------------
 * FOOTER & HINTS MESSAGE
 * -------------------------------------------------- */
message {
    background-color: @bg-alt;
    border: 1px;
    border-color: @border-col;
    border-radius: @radius;
    padding: 8px 14px;
}

textbox {
    background-color: transparent;
    text-color: @fg-muted;
    font: "JetBrainsMono Nerd Font 11";
    vertical-align: 0.5;
}
